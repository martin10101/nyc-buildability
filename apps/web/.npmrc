# NYC Buildability web — dependency-admission config (task M0-T019).
#
# This file is DEFENSE-IN-DEPTH at lock RESOLUTION time. It is NOT the machine
# gate for the committed lockfile — that is scripts/dependency_age_gate.mjs
# (FE-S9), which independently re-verifies every entry `npm ci` installs. See
# docs/DEPENDENCY_SECURITY_POLICY.md for the four enforcement layers.

# Every version admitted by a fresh resolution must be at least 7 complete days
# old. Resolver-time filter only; it does NOT gate an already-committed lock.
min-release-age=7

# New dependencies are written as EXACT versions (no ^/~) so future `npm i pkg`
# adds a pinned version, matching the exact-pin policy (FE-S10).
save-exact=true

# Keep npm's integrity + lockfile verification at full strength. `npm ci` must
# fail if the lockfile is missing or does not match package.json, and every
# tarball's integrity is verified against the lock. Do not weaken these.
package-lock=true
