    {
      "id": "S1",
      "given": "recorded community district 101 to 108 (Manhattan Core), or any special-district token DB",
      "when": "the record is read",
      "then": "in a special density area: no unit factor applies, the limit stays withheld as today"
    },
    {
      "id": "S2",
      "given": "a lot recorded outside Manhattan Community Districts 1 to 8 and with every special-district column read and none DB (for example Queens cd 411; Manhattan cd 109; Marble Hill cd 207)",
      "when": "the record is read",
      "then": "not in a special density area; the unit limit is computed with the factor 680 and the 0.75 rounding and shown as a conditional ceiling with the zoning-lot condition, never settled"
    },
    {
      "id": "S3",
      "given": "the special-district columns not read, or the community district not usable for a Manhattan lot, or a contradiction (cd 105 with borough code 3), or cd 164",
      "when": "the record is read",
      "then": "not known; the limit stays withheld; no default stands for a fact"
    },
    {
      "id": "S4",
      "given": "each of the nine record-by-statement combinations",
      "when": "the decision runs",
      "then": "a statement never overrides the record; a disagreement is withheld with both sides named; the engine is given 'not in one' if and only if the limit is shown (invariant test)"
    },
    {
      "id": "S5",
      "given": "made-up recorded-not-in-one lots",
      "when": "the limit is computed through the route",
      "then": "20,230 / 680 = 29.75 gives 30; 20,228 / 680 = 29.747 gives 29 (expected values from ZR 23-52, not a program run)"
    },
    {
      "id": "S6",
      "given": "the benchmark 215-16 Northern Boulevard",
      "when": "the journey runs",
      "then": "the legal unit limit reads 29 as a conditional ceiling, labelled Conditional, kept apart from the apartment estimate; fixtures and snapshots regenerated, every changed expectation explained"
    },
    {
      "id": "S7",
      "given": "the review register and record NB-05",
      "when": "the register check and the record check run",
      "then": "the affected calculation entries carry a new revision, code identity, history event and test log; NB-05 revision 2 links the new code and regression tests; both checks pass"
    }
