+        with self.assertRaises(lp.LoopError) as raised:
+            lp.LoopConfig(mode="supervised", task_id="M0-T036", stage="phase4",
+                          session_role="admin")
+        self.assertEqual(raised.exception.code, "unknown_session_role")
