{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "1800000"
  },
  "permissions": {
    "deny": [
      "mcp__*"
    ],
    "allow": [
      "Bash(python -m tools.agent_supervisor *)"
    ]
  },
  "model": "claude-fable-5",
  "fallbackModel": [
    "claude-opus-4-8"
  ],
  "enableAllProjectMcpServers": false,
  "disabledMcpjsonServers": [
    "supabase",
    "mysql",
    "sequential-thinking",
    "playwright"
  ],
  "disableClaudeAiConnectors": true,
  "allowedMcpServers": [],
  "deniedMcpServers": [
    {
      "serverName": "pencil"
    },
    {
      "serverName": "supabase"
    },
    {
      "serverName": "mysql"
    },
    {
      "serverName": "sequential-thinking"
    },
    {
      "serverName": "playwright"
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/agent_dispatch_guard.py\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/readonly_agent_guard.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/directive_reminder.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/loop_command_interceptor.py\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/directive_reminder.py\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python -m tools.agent_supervisor.telemetry_statusline --journal .claude/telemetry/statusline_journal.jsonl"
  },
  "effortLevel": "xhigh"
}
